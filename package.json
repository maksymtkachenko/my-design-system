{
  "name": "my-design-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build:packages && npm run build-storybook",
    "check": "npm run build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.figma.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run storybook",
    "figma:parse": "figma connect parse --skip-update-check --outFile figma/compiled.json",
    "test:browser": "playwright test",
    "build:packages": "node scripts/build.mjs",
    "storybook": "npm run build:packages && storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build -o apps/docs/dist --disable-telemetry"
  },
  "devDependencies": {
    "@figma/code-connect": "2.1.0",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "storybook": "^10.6.7",
    "typescript": "5.9.3"
  }
}
