{
  "name": "my-design-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run build && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.figma.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run dev --workspace @mds/docs",
    "figma:parse": "figma connect parse --skip-update-check --outFile figma/compiled.json",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@figma/code-connect": "2.1.0",
    "@playwright/test": "1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "5.9.3"
  }
}
