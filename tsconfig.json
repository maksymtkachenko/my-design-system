{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["react", "react-dom"],
    "noEmit": true
  },
  "include": ["packages/react/src", "packages/react-native/src", "apps/docs/src"]
}
